# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# `.env` is already listed in .gitignore.

# Deployer key used ONLY by the Hardhat deploy script (CLI path).
# If you would rather never touch a private key on this machine, deploy from the
# dApp UI instead (web/ > Deploy panel) and leave this blank.
DEPLOYER_PRIVATE_KEY=

# Public JSON-RPC endpoints (defaults are used when blank).
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# BscScan API key, only needed for automated source verification.
# Manual verification in the BscScan UI works without a key.
BSCSCAN_API_KEY=
